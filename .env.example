# - Database ---------------------------------
MYSQL_ROOT_PASSWORD=changeme_root
MYSQL_PASSWORD=changeme

# - Security ---------------------------------
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=changeme_generate_a_strong_random_key

# - Meilisearch -------------------------------
MEILISEARCH_KEY=changeme_meili_master_key

# - GitHub OAuth -------------------------------
# Create an OAuth App at https://github.com/settings/developers
# Callback URL: http://localhost:8000/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# - GitLab OAuth -------------------------------
# Create an OAuth App at https://gitlab.com/-/profile/applications
# Required scopes: read_user, read_api
# Callback URL: http://localhost:8000/api/auth/gitlab/callback
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=

# - Email ----------------------------------
# At least one provider is required to send invitations by email.
# Without configuration, email sending is disabled - the invitation link
# must then be shared manually.

# Option 1 - Generic SMTP (Gmail, Google Workspace, Microsoft 365, Zoho, etc.)
# Gmail: SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  (enable "App Password")
# MS365: SMTP_HOST=smtp.office365.com  SMTP_PORT=587
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Option 2 - Resend (https://resend.com) - takes priority over SendGrid / Mailgun
RESEND_API_KEY=

# Option 3 - SendGrid (https://sendgrid.com)
SENDGRID_API_KEY=

# Option 4 - Mailgun (https://mailgun.com)
MAILGUN_API_KEY=
MAILGUN_DOMAIN=

# Sender address (used by all providers)
EMAIL_FROM=noreply@glyph.app

# - Ports (auto-detected by install.sh, change manually if needed) ------------
FRONTEND_PORT=3000
BACKEND_PORT=8000

# - URLs (leave as-is for local) ----------------------------------------------
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
# APP_URL = public backend URL (used for GitLab OAuth redirects)
APP_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000
